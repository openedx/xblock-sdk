{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:typescript": "tsc -b",
    "build:vite": "vite build",
    "build": "pnpm run build:typescript && pnpm run build:vite",
    "build:watch": "vite build --watch",
    "lint": "oxlint . && oxfmt --check",
    "lint:fix": "oxlint . --fix && oxfmt .",
    "format": "oxfmt",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opencraft/xblock-react-utils": "^0.1.1",
    "@openedx/paragon": "^23.23.0",
    "formik": "^2.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-focus-on": "^3.10.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jquery": "^4.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "globals": "^17.13.0",
    "jquery": "^4.0.0",
    "jquery-mockjax": "^3.0.1",
    "jsdom": "^25.0.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "react-intl": "^6.8.9",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "=24",
    "pnpm": ">=10"
  }
}
